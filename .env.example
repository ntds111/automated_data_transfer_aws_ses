# Replace all example resources and addresses before running.
# Loaded explicitly by the shell or Docker; never committed as .env.
AWS_REGION=eu-central-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/reporting-role
SES_EMAIL_SOURCE=reports@example.com
ATHENA_DATABASE=default
ATHENA_OUTPUT_LOCATION=s3://example-report-bucket/results/
ATHENA_QUERY='SELECT * FROM your_table WHERE shop_id = {shop_id}'
SHOP_RECIPIENTS='{"12345": ["recipient@example.com"], "67890": ["recipient@example.com"]}'
# Use an AWS profile locally or an IAM execution role in Lambda.
# Never put credentials into this example or source control.
